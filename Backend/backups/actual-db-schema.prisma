generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TravelStyle {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       Trip[]
}

model Vibe {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       Trip[]
}

model DestinationCategory {
  id           String                       @id @default(uuid())
  name         String                       @unique
  description  String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  destinations DestinationCategoryMapping[]
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  avatar            String?
  created_at        DateTime            @default(now())
  full_name         String
  is_verified       Boolean             @default(false)
  phone             String              @unique
  status            UserStatus          @default(ACTIVE)
  updated_at        DateTime            @updatedAt
  bookings          Booking[]
  emailVerification EmailVerification[]
  refreshTokens     RefreshToken[]
  trips             Trip[]
  roles             UserRole[]
  vendors           Vendor[]
  reviews           VendorReview[]
}

model Trip {
  title            String
  description      String?
  createdAt        DateTime          @default(now())
  id               String            @id @default(uuid())
  budgetRange      BudgetRange
  endDate          DateTime?
  isPublic         Boolean           @default(false)
  shareToken       String?           @unique
  startDate        DateTime?
  status           TripStatus        @default(DRAFT)
  totalDays        Int?
  travelerCount    Int               @default(1)
  updatedAt        DateTime          @updatedAt
  userId           String
  travelStyleId    String
  vibeId           String
  bookings         Booking[]
  travelStyle      TravelStyle       @relation(fields: [travelStyleId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vibe             Vibe              @relation(fields: [vibeId], references: [id])
  tripDestinations TripDestination[]

  @@index([userId])
  @@index([travelStyleId])
  @@index([vibeId])
}

model Destination {
  id               String                       @id @default(uuid())
  name             String
  slug             String                       @unique
  district         String
  province         String
  description      String?
  coverImage       String?
  latitude         Float
  longitude        Float
  isActive         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  address          String?
  placeId          String?                      @unique
  rating           Float?
  reviewCount      Int?
  source           String                       @default("manual")
  categories       DestinationCategoryMapping[]
  images           DestinationImage[]
  tags             DestinationTag[]
  tripDestinations TripDestination[]

  @@index([district])
  @@index([province])
}

model DestinationImage {
  id            String      @id @default(uuid())
  destinationId String
  url           String
  width         Int?
  height        Int?
  isPrimary     Boolean     @default(false)
  source        String      @default("google")
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model DestinationTag {
  id            String      @id @default(uuid())
  destinationId String
  tag           String
  confidence    Float       @default(0.0)
  source        String      @default("ai")
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([tag])
}

model UserDestinationInteraction {
  id            String   @id @default(uuid())
  userId        String
  destinationId String
  action        String
  weight        Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([destinationId])
}

model TripDestination {
  id            String      @id @default(uuid())
  tripId        String
  destinationId String
  visitOrder    Int
  arrivalDate   DateTime?
  departureDate DateTime?
  nights        Int?
  notes         String?
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([destinationId])
}

model DestinationCategoryMapping {
  id            String              @id @default(uuid())
  destinationId String
  categoryId    String
  category      DestinationCategory @relation(fields: [categoryId], references: [id])
  destination   Destination         @relation(fields: [destinationId], references: [id])

  @@unique([destinationId, categoryId])
  @@index([destinationId])
  @@index([categoryId])
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  tripId    String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Vendor {
  id            String                @id @default(uuid())
  userId        String
  categoryId    String
  name          String
  description   String?
  status        VendorStatus          @default(PENDING)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  statusReason  String?
  fieldSetId    String?
  averageRating Float                 @default(0)
  reviewCount   Int                   @default(0)
  category      VendorCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fieldSet      FieldSet?             @relation(fields: [fieldSetId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields        VendorFieldValue[]
  media         VendorMedia[]
  packages      VendorPackage[]
  reviews       VendorReview[]
  statusHistory VendorStatusHistory[]

  @@index([userId])
  @@index([categoryId])
}

model VendorCategory {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String        @unique
  description  String?
  fieldSetId   String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packageTypes PackageType[]
  vendors      Vendor[]
  fieldSet     FieldSet      @relation(fields: [fieldSetId], references: [id])

  @@index([fieldSetId])
}

model VendorMedia {
  id        String          @id @default(uuid())
  vendorId  String
  type      VendorMediaType
  url       String
  fileName  String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorReview {
  id        String   @id @default(uuid())
  vendorId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model FieldSet {
  id               String           @id @default(uuid())
  name             String
  description      String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  isCustom         Boolean          @default(false)
  fields           FieldSetField[]
  vendors          Vendor[]
  vendorCategories VendorCategory[]
}

model Field {
  id           String             @id @default(uuid())
  name         String
  label        String
  dataType     FieldDataType
  placeholder  String?
  helpText     String?
  defaultValue String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  options      FieldOption[]
  fieldSets    FieldSetField[]
  vendorValues VendorFieldValue[]
}

model FieldSetField {
  id           String   @id @default(uuid())
  fieldSetId   String
  fieldId      String
  displayOrder Int
  isRequired   Boolean  @default(false)
  readOnly     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  field        Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldSet     FieldSet @relation(fields: [fieldSetId], references: [id], onDelete: Cascade)

  @@unique([fieldSetId, fieldId])
  @@index([fieldSetId])
  @@index([fieldId])
}

model FieldOption {
  id           String   @id @default(uuid())
  fieldId      String
  label        String
  value        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  field        Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
}

model VendorFieldValue {
  id        String   @id @default(uuid())
  vendorId  String
  fieldId   String
  value     String
  createdAt DateTime @default(now())
  field     Field    @relation(fields: [fieldId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, fieldId])
  @@index([vendorId])
  @@index([fieldId])
}

model VendorStatusHistory {
  id             String        @id @default(uuid())
  vendorId       String
  previousStatus VendorStatus?
  newStatus      VendorStatus
  reason         String?
  changedBy      String
  changedAt      DateTime      @default(now())
  vendor         Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model PackageType {
  id             String               @id @default(uuid())
  categoryId     String
  name           String
  description    String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  category       VendorCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fieldSet       PackageTypeFieldSet?
  vendorPackages VendorPackage[]
}

model PackageTypeFieldSet {
  id            String             @id @default(uuid())
  packageTypeId String             @unique
  fields        PackageTypeField[]
  packageType   PackageType        @relation(fields: [packageTypeId], references: [id], onDelete: Cascade)
}

model PackageTypeField {
  id           String              @id @default(uuid())
  fieldSetId   String
  fieldId      String
  isRequired   Boolean             @default(false)
  displayOrder Int                 @default(0)
  field        PackageField        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldSet     PackageTypeFieldSet @relation(fields: [fieldSetId], references: [id], onDelete: Cascade)
}

model VendorPackage {
  id            String                    @id @default(uuid())
  vendorId      String
  packageTypeId String
  title         String
  description   String?
  basePrice     Float
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  packageType   PackageType               @relation(fields: [packageTypeId], references: [id], onDelete: Cascade)
  vendor        Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fieldValues   VendorPackageFieldValue[]
}

model VendorPackageFieldValue {
  id        String        @id @default(uuid())
  packageId String
  fieldId   String
  value     String
  field     PackageField  @relation(fields: [fieldId], references: [id])
  package   VendorPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model PackageField {
  id                String                    @id @default(uuid())
  name              String
  label             String
  dataType          FieldDataType
  placeholder       String?
  helpText          String?
  defaultValue      String?
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  options           PackageFieldOption[]
  packageTypeFields PackageTypeField[]
  packageValues     VendorPackageFieldValue[]
}

model PackageFieldOption {
  id           String       @id @default(uuid())
  fieldId      String
  label        String
  value        String
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  field        PackageField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TripStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorMediaType {
  LOGO
  IMAGE
  DOCUMENT
  CERTIFICATE
}

enum FieldDataType {
  TEXT
  NUMBER
  TEXTAREA
  SELECT
  RADIO
  CHECKBOX
  DATE
  EMAIL
  PHONE
}

enum BudgetRange {
  BUDGET
  MID
  PREMIUM
  LUXURY
}


